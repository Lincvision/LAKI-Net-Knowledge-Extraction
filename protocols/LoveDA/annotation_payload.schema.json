{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loveda_cpeg_v1.annotation_payload.schema.json",
  "title": "LoveDA CPEG single-image annotation payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image_id",
    "graph_status",
    "quality_flags",
    "roles",
    "evidence",
    "relations"
  ],
  "properties": {
    "image_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "graph_status": {
      "enum": [
        "usable",
        "partial",
        "no_reliable_evidence"
      ]
    },
    "quality_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_truncation",
        "shadow_interference",
        "orthophoto_distortion"
      ],
      "properties": {
        "boundary_truncation": {
          "$ref": "#/$defs/qualityFlag"
        },
        "shadow_interference": {
          "$ref": "#/$defs/qualityFlag"
        },
        "orthophoto_distortion": {
          "$ref": "#/$defs/qualityFlag"
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elevated_porous",
        "ground_vegetation",
        "elevated_closed_rigid",
        "open_hard_surface",
        "small_rigid_group"
      ],
      "properties": {
        "elevated_porous": {
          "$ref": "#/$defs/roleAttributes"
        },
        "ground_vegetation": {
          "$ref": "#/$defs/roleAttributes"
        },
        "elevated_closed_rigid": {
          "$ref": "#/$defs/roleAttributes"
        },
        "open_hard_surface": {
          "$ref": "#/$defs/roleAttributes"
        },
        "small_rigid_group": {
          "$ref": "#/$defs/roleAttributes"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "porous_crown_texture",
        "branching_structure",
        "elevated_cast_shadow",
        "continuous_fine_vegetation_texture",
        "closed_rigid_contour",
        "roof_surface_consistency",
        "open_hard_surface_continuity",
        "repeated_small_rigid_shapes"
      ],
      "properties": {
        "porous_crown_texture": {
          "$ref": "#/$defs/evidenceAttributes"
        },
        "branching_structure": {
          "$ref": "#/$defs/evidenceAttributes"
        },
        "elevated_cast_shadow": {
          "$ref": "#/$defs/evidenceAttributes"
        },
        "continuous_fine_vegetation_texture": {
          "$ref": "#/$defs/evidenceAttributes"
        },
        "closed_rigid_contour": {
          "$ref": "#/$defs/evidenceAttributes"
        },
        "roof_surface_consistency": {
          "$ref": "#/$defs/evidenceAttributes"
        },
        "open_hard_surface_continuity": {
          "$ref": "#/$defs/evidenceAttributes"
        },
        "repeated_small_rigid_shapes": {
          "$ref": "#/$defs/evidenceAttributes"
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/relationAttributes"
      }
    }
  },
  "$defs": {
    "qualityFlag": {
      "enum": [
        "none",
        "mild",
        "strong"
      ]
    },
    "presence": {
      "enum": [
        "present",
        "absent",
        "unknown"
      ]
    },
    "organization": {
      "enum": [
        "isolated",
        "scattered",
        "clustered",
        "continuous",
        "fragmented",
        "repeated",
        "unknown",
        "not_applicable"
      ]
    },
    "visibility": {
      "enum": [
        "clear",
        "partial",
        "poor",
        "not_applicable"
      ]
    },
    "roleAttributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presence",
        "organization",
        "visibility"
      ],
      "properties": {
        "presence": {
          "$ref": "#/$defs/presence"
        },
        "organization": {
          "$ref": "#/$defs/organization"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        }
      }
    },
    "evidenceAttributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observability"
      ],
      "properties": {
        "state": {
          "enum": [
            "present",
            "absent",
            "unknown",
            "not_applicable"
          ]
        },
        "observability": {
          "$ref": "#/$defs/visibility"
        }
      }
    },
    "relationAttributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "source_role",
        "relation_type",
        "target_role",
        "state",
        "observability"
      ],
      "properties": {
        "relation_id": {
          "enum": [
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "source_role": {
          "enum": [
            "elevated_porous",
            "elevated_closed_rigid",
            "small_rigid_group"
          ]
        },
        "relation_type": {
          "enum": [
            "occlusion_evidence",
            "interrupts_continuity",
            "projected_on"
          ]
        },
        "target_role": {
          "enum": [
            "ground_vegetation",
            "open_hard_surface"
          ]
        },
        "state": {
          "enum": [
            "observed",
            "not_observed",
            "unknown",
            "not_applicable"
          ]
        },
        "observability": {
          "$ref": "#/$defs/visibility"
        }
      }
    }
  }
}
